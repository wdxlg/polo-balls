static func play(context:Node,role:String,variant:int,point:Vector2) -> Dictionary:
	if not EVENTS.has(role): return {}
	var record:Dictionary = EVENTS[role][posmod(variant,EVENTS[role].size())]
	var gain:float = {"sleep":-9.0,"z":0.0,"wake":0.0,"hurt":-3.0,"death":0.0}.get(role,0.0)
	return QUEUE.queue_stream(context,record.stream,point,{"volume_db":gain,"pitch":record.pitch,"priority":role in ["hurt","death"],"keep_after_source":role=="death","metadata":{"mc_sound_event":record.event,"ding_sound_role":role}})
