# Godot 4+ specific ignores
.godot/
/android/

# 本地 Python 虚拟环境（949MB，不入库；用 requirements 重建）
rl_env/

# 性能工具链（godot-cpp、native 构建产物、godot_release.exe）
.performance_tools/

# 根目录手工 zip 快照（git 接管后不再需要）
*.zip

# RL 训练产物：checkpoints / tensorboard 日志不入库，导出的 onnx 模型保留
rl_training/runs/
rl_training/__pycache__/
__pycache__/
*.pyc

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.log
# local engine binary (104 MB, over GitHub 100 MB limit)
/godot.exe
# 临时文件：用完即删，永不提交（见 MCP_CONTEXT.md 第 0 节）
*.err
*.stdout
*.stderr
*.b64
*.bak
*.before
*.orig
*.rej
.backups/
.arena_*/
tools/checkpoints/
tests/patches/
tests/_*_userdata/
tests/*validation*.json
scripts/training/benchmark_*.json

# Private export credentials and release outputs never belong in source control.
*.key
*.pck
*.pdb
export_credentials.cfg
