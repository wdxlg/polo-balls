[node name="头盔_整体调整" type="Node2D" parent="Graphics" parent_id_path=PackedInt32Array(1055880812) index="2" unique_id=582140121]
editor_description = "头盔前后两层的统一可视调整节点，做法与防御盔甲架一致。只移动/缩放这个节点即可同时调整前后层；运行时会根据铁/钻石/下界合金等级自动换图。编辑器里默认显示铁头盔仅用于对位，角色实战出生仍是无头盔。"
position = Vector2(0, -39)
scale = Vector2(0.095, 0.095)

