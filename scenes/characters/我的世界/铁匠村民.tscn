[node name="剑_攻击枢轴" type="Node2D" parent="Graphics" parent_id_path=PackedInt32Array(1055880812) index="3" unique_id=320162377]
editor_description = "V81 挥剑枢轴：攻击时脚本只旋转/移动这个节点。剑贴图的 offset 已把握把中心对到枢轴原点，因此会像手握剑一样画弧，而不是绕贴图中心转圈。待机时整个节点隐藏。"
visible = false

[node name="剑_攻击显示" type="Sprite2D" parent="Graphics/剑_攻击枢轴" index="0" unique_id=1496378202]
editor_description = "剑只在实际攻击动画期间显示。offset = (301,-275) 是按 Iron_Sword.png 的握把中心对位；若以后换同构图可在编辑器里微调 Offset。"
z_index = 4
z_as_relative = false
texture_filter = 1
scale = Vector2(0.07, 0.07)
texture = ExtResource("6_iron_sword")
offset = Vector2(301, -275)

[node name="锻造_可视调整" type="Node2D" parent="Graphics" parent_id_path=PackedInt32Array(1055880812) index="4" unique_id=2010933139]
editor_description = "V89 锻造动画可视调整区。这里的预览只在编辑器里用于对位；进入游戏后脚本会先读取这些节点的 Transform，再自动隐藏整组预览。直接在 2D 视图拖动/旋转/缩放下面节点即可，不需要再猜代码坐标。"

[node name="物品_入场" type="Sprite2D" parent="Graphics/锻造_可视调整" index="0" unique_id=1453986716]
editor_description = "正在锻造的物品最初出现位置。只需要拖动位置；最终尺寸/平放倾斜请调整「物品_锻造位置」。"
modulate = Color(0.55, 0.8, 1, 0.35)
z_index = 4
z_as_relative = false
texture_filter = 1
position = Vector2(15.000002, 40)
scale = Vector2(0.0761719, 0.0548438)
texture = ExtResource("6_iron_sword")

[node name="物品_锻造位置" type="Sprite2D" parent="Graphics/锻造_可视调整" index="1" unique_id=1081363392]
editor_description = "最重要的物品最终锻造姿态。可直接拖动 Position；缩放 X 控制物品总体大小，Y/X 比例控制平放压扁程度；Skew 控制 2.5D 平放倾斜。Rotation 建议保持 0。运行时会读取这些值。"
modulate = Color(1, 0.65, 0.2, 0.72)
z_index = 4
z_as_relative = false
texture_filter = 1
position = Vector2(20.000002, 45)
scale = Vector2(0.0761719, 0.0335156)
skew = 0.244346
texture = ExtResource("6_iron_sword")

