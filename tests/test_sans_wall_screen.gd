extends "res://tests/test_mc_bat_transform.gd"
func run() -> void:
	var center:Vector2=await setup_world()
	var s:Node=spawn("res://scenes/characters/传说之下/Sans.tscn",center)
	s.state_machine.set_physics_process(false);s.set_process(false)
	var rolling:Script=load("res://scripts/effects/传说之下/Sans滚动骨头.gd")
	var final_bone:Script=load("res://scripts/effects/传说之下/Sans终幕骨列.gd")
	var slots:Script=load("res://scripts/effects/传说之下/sans_wall_slots.gd")
	for direction:Vector2 in [Vector2.RIGHT,Vector2.LEFT,Vector2.UP,Vector2.DOWN]:
		var bone:Node2D=rolling.new();world.add_child(bone);bone.set_physics_process(false)
		bone.configure(s,center,Vector2.UP,direction,24.0,100.0,32.0,1.0)
		var screen:Rect2=bone.get_viewport_rect()
		var inverse:Transform2D=bone.get_canvas_transform().affine_inverse()
		bone.global_position=inverse*screen.get_center();bone._distance_moved=25.0
		check(not bone._should_retire(),"old distance threshold never removes visible bone: "+str(direction))
		var before:Vector2=bone.global_position
		game.now_stop_state=true;bone._physics_process(2.0)
		check(bone.global_position==before,"rolling freezes on pause")
		game.now_stop_state=false
		bone.global_position=inverse*(screen.get_center()+direction*maxf(screen.size.x,screen.size.y)*2.0)
		check(bone._should_retire(),"fully beyond outgoing screen edge retires: "+str(direction))
		bone.global_position=inverse*(screen.get_center()-direction*maxf(screen.size.x,screen.size.y)*2.0)
		check(not bone._should_retire(),"offscreen entrance is not mistaken for exit")
		bone.free()
	var moving:Node2D=final_bone.new();world.add_child(moving);moving.set_physics_process(false)
	moving.configure_final(s,center,Vector2.DOWN,Vector2.LEFT,5.0,30.0,0.01)
	moving.global_position=moving.get_canvas_transform().affine_inverse()*moving.get_viewport_rect().get_center()
	moving._physics_process(0.02)
	check(not moving.is_queued_for_deletion(),"final scrolling ignores expired lifetime while visible")
	moving.free()
	var stationary:Node2D=final_bone.new();world.add_child(stationary);stationary.set_physics_process(false)
	stationary.configure_final(s,center,Vector2.DOWN,Vector2.ZERO,0.0,30.0,0.01)
	stationary._physics_process(0.02)
	check(stationary.is_queued_for_deletion(),"stationary corridor still expires normally")
	var rect:Rect2=Rect2(center,Vector2(80,40))
	s._rpc_spawn_bone_attack(rect,0)
	check(not slots.available(s,0) and slots.available(s,2),"normal spike reserves only its wall")
	var n:int=get_nodes_in_group("SansWallAttack").size()
	s._rpc_spawn_bone_attack(rect,0)
	s._rpc_spawn_rolling_bone(center,Vector2.DOWN,Vector2.RIGHT,24,100,30,1,"train")
	check(get_nodes_in_group("SansWallAttack").size()==n,"normal and rolling spawn endpoints reject occupied wall")
	s._rpc_spawn_rolling_bone(center,Vector2.UP,Vector2.RIGHT,24,100,30,1,"train")
	s._rpc_spawn_rolling_bone(center+Vector2(20,0),Vector2.UP,Vector2.RIGHT,24,100,30,1,"train")
	check(get_nodes_in_group("SansWallAttack").size()==n+2,"one train may contain multiple spaced bones")
	s._rpc_spawn_rolling_bone(center,Vector2.UP,Vector2.LEFT,24,100,30,1,"other_train")
	check(get_nodes_in_group("SansWallAttack").size()==n+2,"second train on same wall cannot overlap")
	for effect:Node in get_nodes_in_group("SansWallAttack"): effect.queue_free()
	check(slots.available(s,0) and slots.available(s,2),"queued cleanup releases wall slots")
	print("SANS_WALL_SCREEN checks=",checks," failures=",failures)
	finish(0 if failures==0 else 1)
