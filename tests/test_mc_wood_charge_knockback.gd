extends "res://tests/test_mc_frontier.gd"
## Charge is independent of displacement, not of real stuns or attack restrictions.
func push(unit:Node2D,options:Dictionary = {}) -> Node:
	var effect:Node = unit.apply_knockback(Vector2.RIGHT,100.0,180.0,0.0,0.0,options)
	effect.set_physics_process(false)
	return effect

func run() -> void:
	var center:Vector2 = await setup_world()
	create_timer(60.0).timeout.connect(func(): finish(2))
	var sword:Node2D = actor("木剑",center)
	sword.direction = Vector2.RIGHT
	sword.set_player_control_peer(0)
	sword.sword_charge = 0.4
	var effect:Node = push(sword)
	check(sword.dizziness and sword.Repel.length()>0.0,"ordinary knockback retains its movement lock and impulse")
	var impulse:Vector2 = sword.Repel
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.5),"AI charge keeps advancing while knocked back")
	check(sword.dizziness and sword.Repel==impulse and effect.is_active_effect(),"charging does not release or weaken knockback")
	check(not sword.begin_swing(),"movement lock still prevents starting an attack")
	var point:Vector2 = sword.global_position
	sword.stand(1.0/60.0)
	check(sword.global_position.distance_to(point)>0.0,"knockback still physically moves the charging sword")
	var replaced:Node = push(sword)
	check(replaced==effect,"repeated hits retain the shared displacement controller")
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.6),"redirected knockback cannot reset charge")
	effect._finish_knockback(false)
	check(effect._stage==2,"normal displacement transitions into control recovery")
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.7),"charge also survives control recovery")
	effect._finish(false)
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.8),"AI resumes from accumulated charge after recovery")
	sword.set_player_control_peer(1)
	sword.player_control_action_cancelled(0)
	sword.player_control_action(0)
	sword.step_mob(0.8)
	check(is_equal_approx(sword.sword_charge,0.4) and sword._manual_charging,"manual hold begins ordinary charging")
	effect = push(sword)
	var health_before:int = sword.health
	var durability_before:int = sword.durability
	sword.take_damage(5.0,true)
	sword.step_mob(0.2)
	check(sword.health==health_before-5 and sword.durability<durability_before,"damage and durability costs remain active during knockback")
	check(is_equal_approx(sword.sword_charge,0.5) and sword._manual_charging,"manual hold survives both damage and displacement")
	sword.player_control_action_released(0)
	check(not sword._swing_pending and is_equal_approx(sword.sword_charge,0.5),"release during displacement keeps charge without attacking early")
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.5),"released charge no longer grows while waiting for control")
	effect._finish(false)
	sword.step_mob(0.01)
	check(sword._swing_pending and is_equal_approx(sword._swing_charge,0.5),"queued manual release swings with the retained charge")
	var durability_after:int = sword.durability
	sword.advance_attack(sword.attack_duration())
	sword.step_mob(0.6)
	check(not sword._swing_pending and sword.durability==durability_after,"queued release produces only one swing")
	sword.player_control_action_cancelled(0)
	effect = push(sword)
	sword.player_control_action(0)
	sword.step_mob(0.8)
	check(sword._manual_charging and is_equal_approx(sword.sword_charge,0.4),"manual charge can start during ordinary displacement")
	sword.player_control_action_released(0)
	sword.player_control_action_cancelled(0)
	effect._finish(false)
	sword.step_mob(0.1)
	check(sword.sword_charge==0.0 and not sword._swing_pending,"explicit input cancellation removes any queued release")
	sword.player_control_action(0)
	sword.step_mob(0.1)
	effect = push(sword)
	sword.player_control_action_released(0)
	effect._finish(false)
	sword.step_mob(0.1)
	check(sword.sword_charge==0.0 and not sword._swing_pending,"too-short charge still cannot queue a swing")
	sword.player_control_action(0)
	sword.step_mob(0.8)
	effect = sword.apply_stun(1.0)
	effect.set_physics_process(false)
	sword.step_mob(0.1)
	check(sword.sword_charge==0.0 and not sword._manual_charging,"true stun still cancels charge")
	effect._finish(false)
	sword.player_control_action(0)
	sword.step_mob(0.8)
	effect = push(sword)
	var stun:Node = sword.apply_knockback(Vector2.ZERO,0.0,0.0,0.0,1.0,{"replace_existing":false})
	stun.set_physics_process(false)
	sword.step_mob(0.1)
	check(sword.sword_charge==0.0,"overlapping true stun is not hidden by displacement")
	stun._finish(false)
	effect._finish(false)
	sword.sword_charge = 0.4
	sword.dizziness = true
	effect = push(sword)
	sword.step_mob(0.1)
	check(sword.sword_charge==0.0,"preexisting non-knockback control is not treated as displacement")
	effect._finish(false)
	sword.dizziness = false
	sword.player_control_action(0)
	sword.step_mob(0.8)
	effect = push(sword)
	sword.Can_Attack = false
	sword.step_mob(0.1)
	check(sword.sword_charge==0.0 and not sword._manual_charging,"attack disable still cancels charge during displacement")
	sword.Can_Attack = true
	effect._finish(false)
	sword.player_control_action(0)
	sword.step_mob(0.8)
	effect = push(sword)
	game.now_stop_state = true
	sword.tick_physics(0,0.4)
	check(is_equal_approx(sword.sword_charge,0.4),"pause freezes rather than erases charge")
	game.now_stop_state = false
	effect._finish(false)
	sword.player_control_action_cancelled(0)
	sword.set_player_control_peer(0)
	sword.sword_charge = 0.4
	effect = push(sword)
	var second_push:Node = push(sword,{"replace_existing":false})
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.5),"overlapping displacement locks still preserve charge")
	second_push._finish(false)
	effect._finish(false)
	var piston_push:Node = load("res://scripts/characters/我的世界/new5/piston_push.gd").new()
	piston_push.target = sword
	piston_push.direction = Vector2.RIGHT
	piston_push.distance = 100.0
	piston_push.speed = 180.0
	sword.add_child(piston_push)
	piston_push.set_physics_process(false)
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.6),"derived piston knockback also preserves charge")
	piston_push._handle_wall_collision(Vector2.LEFT,sword.global_position)
	sword.step_mob(0.1)
	check(piston_push._stage==1 and sword.sword_charge==0.0,"piston collision stun still interrupts charge")
	piston_push._finish(false)
	var summary:String = sword.get_armor_test_effect_summary()
	check(not summary.contains("格挡") and not summary.contains("不附带眩晕") and summary.contains("击退不会打断蓄力"),"wooden-sword introduction contains useful traits instead of absent abilities")
	print("WOOD CHARGE KNOCKBACK: ",checks-failures,"/",checks)
	finish(0 if failures==0 else 1)
