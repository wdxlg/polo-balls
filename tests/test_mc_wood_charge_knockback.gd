extends "res://tests/test_mc_frontier.gd"
func push(unit:Node2D) -> Node:
	var effect:Node=unit.apply_knockback(Vector2.RIGHT,100,180)
	effect.set_physics_process(false)
	return effect
func run() -> void:
	game=root.get_node("Game")
	game._settings_storage_path=OS.get_environment("TEMP").path_join("wood_mobile_settings.json")
	var center:Vector2=await setup_world()
	create_timer(60).timeout.connect(func():finish(2))
	var sword:Node2D=actor("木剑",center)
	sword.set_player_control_peer(0)
	sword.sword_charge=0.4
	var first:Node=push(sword)
	sword.step_mob(0.2)
	check(not sword.dizziness and is_equal_approx(sword.sword_charge,0.5),"AI charging continues without any displacement lock")
	var second:Node=push(sword)
	check(first!=second and sword.get_body_motion().impulse_velocity().x>350,"repeated hits add independent impulses")
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.6),"stacked impulses do not reset charge")
	var before:Vector2=sword.global_position
	sword.stand(1.0/60.0)
	check(sword.global_position.x>before.x,"charging sword really moves under force")
	check(sword.begin_swing() and sword._swing_pending,"AI can start an attack during ordinary knockback")
	first._finish(false);second._finish(false)
	sword.advance_attack(sword.attack_duration());sword.step_mob(1.0)
	sword.set_player_control_peer(1)
	sword.player_control_action_cancelled(0)
	sword.player_control_action(0);sword.step_mob(0.8)
	check(sword._manual_charging and is_equal_approx(sword.sword_charge,0.4),"manual hold still accumulates actual charge")
	first=push(sword)
	var hp:int=sword.health;var durability:int=sword.durability
	sword.take_damage(5,true);sword.step_mob(0.2)
	check(sword.health==hp-5 and sword.durability<durability,"damage and durability remain active during force")
	check(is_equal_approx(sword.sword_charge,0.5),"force does not interrupt manual charging")
	sword.player_control_action_released(0)
	check(sword._swing_pending and is_equal_approx(sword._swing_charge,0.5),"release attacks immediately with retained charge during knockback")
	first._finish(false)
	sword.advance_attack(sword.attack_duration());sword.step_mob(1.0)
	sword.player_control_action_cancelled(0)
	sword.player_control_action(0);sword.step_mob(0.8)
	var stun:Node=sword.apply_stun(0.3);stun.set_physics_process(false)
	sword.step_mob(0.01)
	check(sword.sword_charge==0 and not sword._manual_charging,"genuine stun still cancels charge")
	first=push(sword)
	check(sword.is_hard_controlled(),"new impulse cannot hide an existing true stun")
	stun._physics_process(0.31);first._finish(false)
	sword.player_control_action(0);sword.step_mob(0.8)
	first=push(sword);sword.Can_Attack=false;sword.step_mob(0.01)
	check(sword.sword_charge==0 and not sword._manual_charging,"attack prohibition still applies while mobile")
	sword.Can_Attack=true;first._finish(false)
	sword.player_control_action(0);sword.step_mob(0.8)
	var piston:Node=load("res://scripts/characters/我的世界/new5/piston_push.gd").new()
	piston.target=sword;piston.distance=100;piston.speed=180;sword.add_child(piston);piston.set_physics_process(false)
	sword.step_mob(0.2)
	check(is_equal_approx(sword.sword_charge,0.5) and not sword.dizziness,"derived piston force also preserves mobile charging")
	piston._handle_wall_collision(Vector2.LEFT,sword.global_position);sword.step_mob(0.01)
	check(piston._stage==1 and sword.sword_charge==0,"piston wall impact retains explicit stun")
	piston._finish(false)
	print("WOOD_MOBILE_CHARGE checks=",checks," failures=",failures)
	finish(0 if failures==0 else 1)
