new file mode 100644
--- /dev/null
+++ b/scripts/effects/我的世界/mc_charge_circle.gd
@@ -0,0 +1,27 @@
+extends Node2D
+## Reusable world-space Minecraft telegraph. The owner supplies authoritative
+## charge progress; this visual NEVER advances a timer or triggers damage itself.
+const PIXELS = preload("res://scripts/effects/我的世界/pixel_arc.gd")
+var radius:float = 80.0
+var progress:float = 0.0
+var ring_color:Color = Color(1.0,0.22,0.12,0.9)
+var fill_color:Color = Color(1.0,0.12,0.06,0.16)
+
+func _ready() -> void:
+	set_as_top_level(true) # Parent scale/rotation must not alter the damage radius.
+	z_as_relative = false
+	z_index = 1
+	add_to_group("MCChargeCircle")
+
+func set_charge(point:Vector2,world_radius:float,fraction:float) -> void:
+	global_transform = Transform2D(0.0,point)
+	radius = maxf(world_radius,0.0)
+	progress = clampf(fraction,0.0,1.0)
+	queue_redraw()
+
+func fill_radius() -> float:
+	return radius*progress
+
+func _draw() -> void:
+	PIXELS.draw_disk(self,Vector2.ZERO,fill_radius(),fill_color)
+	PIXELS.draw_ring(self,Vector2.ZERO,radius,ring_color)
diff --git a/scripts/effects/我的世界/sulfur_amethyst_crystal.gd b/scripts/effects/我的世界/sulfur_amethyst_crystal.gd
new file mode 100644
--- /dev/null
+++ b/scripts/effects/我的世界/sulfur_amethyst_crystal.gd
@@ -0,0 +1,24 @@
+extends Node3D
+## One original amethyst-cluster cross model, shared by the attached crystal and
+## its projectile. No cone, item-icon substitution, generated image or repaint.
+const TEXTURE:Texture2D = preload("res://Images/characters/我的世界/sulfur_cube/source/amethyst_cluster.png")
+var length:float = 1.6
+var width:float = 0.82
+
+func _ready() -> void:
+	var material := StandardMaterial3D.new()
+	material.albedo_texture = TEXTURE
+	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	material.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
+	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
+	material.cull_mode = BaseMaterial3D.CULL_DISABLED
+	for i:int in range(2):
+		var quad := QuadMesh.new()
+		quad.size = Vector2(width,length)
+		var face := MeshInstance3D.new()
+		face.name = "NativeClusterCross%d" % i
+		face.mesh = quad
+		face.material_override = material
+		face.position.y = length*0.5 # Bottom is the buried root, not the midpoint.
+		face.rotation.y = PI*0.25+float(i)*PI*0.5
+		add_child(face)
