+void Time::set_recording_clock(bool p_enabled) {
+	if (p_enabled && recording_tick_usec.load() < 0) {
+		recording_origin_usec = get_ticks_usec();
+		recording_frames = 0;
+		recording_tick_usec.store(recording_origin_usec);
+	} else if (!p_enabled && recording_tick_usec.load() >= 0) {
+		// Keep pending tick-based cooldowns continuous when returning to real time.
+		recording_offset_usec.store(recording_tick_usec.load() - int64_t(OS::get_singleton()->get_ticks_usec()));
+		recording_tick_usec.store(-1);
+	}
+}
+
+void Time::advance_recording_clock(int p_fps) {
+	if (recording_tick_usec.load() < 0 || p_fps <= 0) return;
+	++recording_frames;
+	recording_tick_usec.store(recording_origin_usec + recording_frames * 1000000ULL / p_fps);
 }
 
